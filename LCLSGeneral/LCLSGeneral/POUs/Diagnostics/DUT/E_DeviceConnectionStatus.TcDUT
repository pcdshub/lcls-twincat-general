<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_DeviceConnectionStatus" Id="{8a1d6c39-4e72-4b05-8f13-7a9c0e4b1d62}">
    <Declaration><![CDATA[(* Combined device diagnostic verdict: LinkStatus gates DataStatus. *)
TYPE E_DeviceConnectionStatus :
(
    Connected,       // LinkStatus = OP and DataStatus = Ok
    NotOperational,  // LinkStatus <> OP
    WcError,         // LinkStatus = OP, DataStatus = WcError
    Stale            // LinkStatus = OP, DataStatus = Stale
) UDINT;
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
