<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_BridgeStatus" Id="{e5c9a378-0f46-4b13-c28d-3a5f1e7c4b9a}">
    <Declaration><![CDATA[(* Combined bridge diagnostic verdict: LinkStatus gates DataStatus. *)
TYPE E_BridgeStatus :
(
    Connected,
    LocalNotOperational,
    ExternalDeviceNotConnected,
    RemoteNotOperational,
    LinkError,
    DataStale
) UDINT;
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
